<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup and device transfer from Android 12 on: as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cubelens.scan.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cubelens.scan.xml" />
    </device-transfer>
</data-extraction-rules>
